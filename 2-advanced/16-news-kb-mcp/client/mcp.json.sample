{
  "mcpServers": {
    "aws-news-kb": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@latest",
        "<NewsGatewayStack の出力 GatewayUrl>",
        "--header",
        "Authorization:${AUTH_HEADER}"
      ],
      "env": {
        "AUTH_HEADER": "Bearer <16.6 で取得したアクセストークン>"
      }
    }
  }
}
