# agent/.env.example
#
# cp .env.example .env して使う。.env はコミットしない。
# [確定] = 一次情報で確認済み  /  [未確定] = 各自の環境で確認が必要
#
# ---------------------------------------------------------------------------
# AWS
# ---------------------------------------------------------------------------
# [確定] 既定モデル（Haiku 4.5）の推論プロファイルが us. 接頭辞で実在することを
#        実機一覧で確認済み（2026-08-23）。AgentCore Runtime は東京（ap-northeast-1）
#        でも利用可能（AWS の "Supported AWS Regions" 表で確認済み）だが、
#        東京の Haiku 4.5 は apac. ではなく jp. プロファイルのみ（同日実機確認）。
#        東京で使う場合は AWS_REGION と BEDROCK_MODEL_ID_PREFIX=jp を両方設定する。
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# Bedrock モデル
# ---------------------------------------------------------------------------
# [確定] リージョン接頭辞 -> 推論プロファイル接頭辞の導出規則。
#        ap-northeast-1 -> "apac" / us-east-1 -> "us" / eu-west-1 -> "eu"
#        （strands-agents 1.52.0 の _get_default_model_with_warning と同じ規則を実装）
# 未設定なら AWS_REGION から自動導出する。
# 新しいモデルには地理（apac）ではなく国別（jp）のプロファイルしか無いものがあるので、
# 導出結果が一覧（aws bedrock list-inference-profiles）と合わないときは明示する。
# オンデマンドで直接呼べるモデルを使う場合は空文字を設定する:  BEDROCK_MODEL_ID_PREFIX=
#BEDROCK_MODEL_ID_PREFIX=jp

# 役割別のベース ID（接頭辞なし）。接頭辞と連結して使われる。
#
# 既定は全役割とも安価な Haiku 4.5（入力 $1 / 出力 $5、100万トークンあたり。2026-08 時点）。
# 学習時の実行コストを抑えるための割り当てで、実案件では判断を伴う
# orchestrator / review を Sonnet 系などの上位モデルに差し替える（第5章）。
# ./scripts/check_env.sh が ID の実在確認を行う。失敗したら表示される ID に直すこと。
# 確認コマンド: aws bedrock list-inference-profiles --region "$AWS_REGION"
#
# 役割ごとの性質（実案件でモデルを割り当て直すときの判断材料）:
#   orchestrator: 観点への分解と結果の統合。判断を伴う（上位モデル候補）。
#   search:       クエリ整形と事実抽出のみ。定型処理なので軽量モデル。
#   review:       出典欠落や推測混入の検出。見逃しが致命的（上位モデル候補）。
MODEL_ID_ORCHESTRATOR=anthropic.claude-haiku-4-5-20251001-v1:0
MODEL_ID_SEARCH=anthropic.claude-haiku-4-5-20251001-v1:0
MODEL_ID_REVIEW=anthropic.claude-haiku-4-5-20251001-v1:0

# 接頭辞の連結を使わず ID を丸ごと指定したい場合の逃げ道。
#MODEL_ID_ORCHESTRATOR_FULL=
#MODEL_ID_SEARCH_FULL=
#MODEL_ID_REVIEW_FULL=

MAX_TOKENS_ORCHESTRATOR=4096
MAX_TOKENS_SEARCH=2048
MAX_TOKENS_REVIEW=2048

# ---------------------------------------------------------------------------
# コスト・暴走対策（値を変えるのは可。ガードを外すのは不可）
# ---------------------------------------------------------------------------
MAX_TOOL_CALLS_TOTAL=12
MAX_TOOL_CALLS_PER_TOOL=6
MAX_AGENT_TURNS=10

# ---------------------------------------------------------------------------
# 検索プロバイダ
# ---------------------------------------------------------------------------
# [確定] mock は API キー不要で決定的な固定データを返す。ローカル実行と評価の再現性のため既定にしている。
#        実際の Web 検索を行うには tavily に切り替えて TAVILY_API_KEY を設定する。
SEARCH_PROVIDER=mock
#TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5

HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# 運用
# ---------------------------------------------------------------------------
# 開発時のみ true。フロントの JWT 検証をスキップする。
AUTH_BYPASS=false
LOG_LEVEL=INFO
