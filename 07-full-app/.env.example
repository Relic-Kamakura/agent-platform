# agent/.env.example
#
# cp .env.example .env して使う。.env はコミットしない。
# [確定] = 一次情報で確認済み  /  [未確定] = 各自の環境で確認が必要
#
# ---------------------------------------------------------------------------
# AWS
# ---------------------------------------------------------------------------
# [確定] AgentCore Runtime は ap-northeast-1（東京）で利用可能。
#        AWS の "Supported AWS Regions" 表で Runtime / Memory / Gateway /
#        Identity / Observability の対応を確認済み。
AWS_REGION=ap-northeast-1

# ---------------------------------------------------------------------------
# Bedrock モデル
# ---------------------------------------------------------------------------
# [確定] リージョン接頭辞 -> 推論プロファイル接頭辞の導出規則。
#        ap-northeast-1 -> "apac" / us-east-1 -> "us" / eu-west-1 -> "eu"
#        （strands-agents 1.52.0 の _get_default_model_with_warning と同じ規則を実装）
# 未設定なら AWS_REGION から自動導出する。
# オンデマンドで直接呼べるモデルを使う場合は空文字を設定する:  BEDROCK_MODEL_ID_PREFIX=
#BEDROCK_MODEL_ID_PREFIX=apac

# 役割別のベース ID（接頭辞なし）。接頭辞と連結して使われる。
#
# [確定] anthropic.claude-sonnet-4-6 は strands-agents 1.52.0 の既定モデル ID と同一。
# [未確定] Haiku 系の ID は本リポジトリでは実機確認していない。
#          ./scripts/check_env.sh が実在確認を行う。失敗したら表示される ID に直すこと。
#          確認コマンド: aws bedrock list-inference-profiles --region "$AWS_REGION"
#
# 割り当て理由:
#   orchestrator: 観点への分解と結果の統合。判断を伴うので上位モデル。
#   search:       クエリ整形と事実抽出のみ。定型処理なので軽量モデル。
#   review:       出典欠落や推測混入の検出。見逃しが致命的なので上位モデル。
MODEL_ID_ORCHESTRATOR=anthropic.claude-sonnet-4-6
MODEL_ID_SEARCH=anthropic.claude-haiku-4-5
MODEL_ID_REVIEW=anthropic.claude-sonnet-4-6

# 接頭辞の連結を使わず ID を丸ごと指定したい場合の逃げ道。
#MODEL_ID_ORCHESTRATOR_FULL=
#MODEL_ID_SEARCH_FULL=
#MODEL_ID_REVIEW_FULL=

MAX_TOKENS_ORCHESTRATOR=4096
MAX_TOKENS_SEARCH=2048
MAX_TOKENS_REVIEW=2048

# ---------------------------------------------------------------------------
# コスト・暴走対策（値を変えるのは可。ガードを外すのは不可）
# ---------------------------------------------------------------------------
MAX_TOOL_CALLS_TOTAL=12
MAX_TOOL_CALLS_PER_TOOL=6
MAX_AGENT_TURNS=10

# ---------------------------------------------------------------------------
# 検索プロバイダ
# ---------------------------------------------------------------------------
# [確定] mock は API キー不要で決定的な固定データを返す。ローカル実行と評価の再現性のため既定にしている。
#        実際の Web 検索を行うには tavily に切り替えて TAVILY_API_KEY を設定する。
SEARCH_PROVIDER=mock
#TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5

HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# 運用
# ---------------------------------------------------------------------------
# 開発時のみ true。フロントの JWT 検証をスキップする。
AUTH_BYPASS=false
LOG_LEVEL=INFO
