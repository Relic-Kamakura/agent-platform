# cp .env.local.example .env.local して使う。.env.local はコミットしない。

# 開発時のみ true。/api/invoke の JWT 検証をスキップする。
# false のときは下の COGNITO_* が必須になる
AUTH_BYPASS=true

# ローカルの 07-full-app に転送する場合に設定（第11.4 のローカル一気通貫）。
# 未設定なら AgentCore Runtime (AGENT_RUNTIME_ARN) を呼ぶ
LOCAL_AGENT_URL=http://127.0.0.1:8080

# --- 以下はデプロイ済み環境向け（第10章の CfnOutput から転記する）---
#AWS_REGION=ap-northeast-1
#AGENT_RUNTIME_ARN=
#COGNITO_USER_POOL_ID=
#COGNITO_CLIENT_ID=
